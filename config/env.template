# Copy this file to config/.env (or project root .env) and fill in values.
# The backend auto-detects configured models and exposes them in the UI selector.

# ---------------------------------------------
# Server settings
# ---------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ---------------------------------------------
# Google Document AI (OCR)  optional
# ---------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/sa.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_LOCATION=us

# ---------------------------------------------
# OpenAI Configuration (works for both Azure OpenAI and Direct OpenAI API)
# GLOBAL DEFAULTS (fallback when a model-specific value is missing)
# If you only use a single deployment, you can fill just these.
# ---------------------------------------------
# API Key (required for both Azure and Direct OpenAI)
OPENAI_API_KEY=

# For Azure OpenAI: Set endpoint and deployment
OPENAI_ENDPOINT=
OPENAI_DEPLOYMENT_NAME=
OPENAI_API_VERSION=2025-01-01-preview

# For Direct OpenAI API: Set base URL and model (optional, defaults to api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ---------------------------------------------
# OpenAI MODEL-SPECIFIC OVERRIDES (optional)
# If provided, they override the global defaults for that model.
# Supported models in the UI:
#   - gpt-40
#   - gpt-o4-mini
#   - gpt-5-mini
#   - gpt-5-nano
# For each model, configure distinct key/endpoint/deployment/version. Missing values fall back to GLOBAL DEFAULTS.
# Format: OPENAI_API_KEY_<MODEL>, OPENAI_ENDPOINT_<MODEL>, etc.
# ---------------------------------------------

# gpt-40
OPENAI_API_KEY_GPT_40=
OPENAI_ENDPOINT_GPT_40=
OPENAI_DEPLOYMENT_NAME_GPT_40=
OPENAI_API_VERSION_GPT_40=2025-01-01-preview

# gpt-o4-mini
OPENAI_API_KEY_GPT_O4_MINI=
OPENAI_ENDPOINT_GPT_O4_MINI=
OPENAI_DEPLOYMENT_NAME_GPT_O4_MINI=
OPENAI_API_VERSION_GPT_O4_MINI=2025-01-01-preview

# gpt-5-mini
OPENAI_API_KEY_GPT_5_MINI=
OPENAI_ENDPOINT_GPT_5_MINI=
OPENAI_DEPLOYMENT_NAME_GPT_5_MINI=
OPENAI_API_VERSION_GPT_5_MINI=2025-01-01-preview

# gpt-5-nano
OPENAI_API_KEY_GPT_5_NANO=
OPENAI_ENDPOINT_GPT_5_NANO=
OPENAI_DEPLOYMENT_NAME_GPT_5_NANO=
OPENAI_API_VERSION_GPT_5_NANO=2025-01-01-preview

# ---------------------------------------------
# Image processing
# ---------------------------------------------
MAX_IMAGE_SIZE=41943040
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,pdf,tiff
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
ENHANCE_IMAGE=false
