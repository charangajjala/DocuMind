# Document OCR API Configuration
# Copy this file to .env and fill in your values

# Google Cloud Configuration (Required)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
DOCUMENT_AI_LOCATION=us

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Configuration  
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# Processing Configuration
MAX_IMAGE_SIZE=10485760
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,pdf,tiff
OCR_CONFIDENCE_THRESHOLD=0.8

# Logging
LOG_LEVEL=INFO

# Azure OpenAI Configuration (Required for Structured Data Extraction)
# Get these values from your Azure OpenAI resource in Azure Portal
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-05-13
